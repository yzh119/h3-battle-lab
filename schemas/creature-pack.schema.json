{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battle Lab Creature Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "creatures"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "creatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "faction",
          "ruleset",
          "stats",
          "mechanisms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "faction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "ruleset": {
            "const": "custom"
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "health",
              "attack",
              "defense",
              "minDamage",
              "maxDamage",
              "speed"
            ],
            "properties": {
              "health": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "attack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "defense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "minDamage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "maxDamage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "speed": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "aiValue": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000,
                "default": 100
              }
            }
          },
          "mechanisms": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "flying"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "count"
                  ],
                  "properties": {
                    "type": {
                      "const": "additionalAttacks"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "mode": {
                      "enum": [
                        "melee",
                        "ranged",
                        "both"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "health"
                  ],
                  "properties": {
                    "type": {
                      "const": "regeneration"
                    },
                    "health": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "count"
                  ],
                  "properties": {
                    "type": {
                      "const": "retaliations"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "blocksRetaliation"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "shots"
                  ],
                  "properties": {
                    "type": {
                      "const": "shooter"
                    },
                    "shots": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "noMeleePenalty": {
                      "type": "boolean"
                    },
                    "noDistancePenalty": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "undead"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "deathCloud"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "attacksAllAdjacent"
                    }
                  }
                }
              ]
            }
          },
          "doubleWide": {
            "type": "boolean",
            "default": false,
            "description": "Occupies two native battle hexes."
          }
        },
        "allOf": [
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "attacksAllAdjacent"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "flying"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "additionalAttacks"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "regeneration"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "retaliations"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "blocksRetaliation"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "shooter"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "undead"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "properties": {
              "mechanisms": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "deathCloud"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            }
          },
          {
            "if": {
              "properties": {
                "mechanisms": {
                  "contains": {
                    "anyOf": [
                      {
                        "properties": {
                          "type": {
                            "const": "deathCloud"
                          }
                        },
                        "required": [
                          "type"
                        ]
                      },
                      {
                        "properties": {
                          "type": {
                            "const": "additionalAttacks"
                          },
                          "mode": {
                            "const": "ranged"
                          }
                        },
                        "required": [
                          "type",
                          "mode"
                        ]
                      }
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "mechanisms": {
                  "contains": {
                    "properties": {
                      "type": {
                        "const": "shooter"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "Runtime additionally checks minDamage <= maxDamage, unique creature IDs, and registered-ID collisions."
}
